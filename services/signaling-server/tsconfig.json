{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@repo/typescript-config/base.json",
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["@cloudflare/vitest-pool-workers/types"],
    "noEmit": true,
  },
  "include": [
    "src/**/*",
    "test/**/*",
    "vitest.config.ts",
    "worker-configuration.d.ts",
  ],
  "exclude": ["node_modules", "dist"],
}
